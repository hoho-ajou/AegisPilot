  "code_patterns": {
    "about": "What non-Python code does (package_caps.py): per language (signals.json languages), [capability kind, regex, target]. Per line (on a code view with comments and printed strings removed), only the first match per kind is kept. Target: 1 = first group, home = the strings joined to homedir() as ~/a/b, null = target unknown. Command strings that JS runs (the process_execute target) are read again with the shell patterns. To add a language, add its patterns here (Python uses the AST analyzer: profile/analyzer.py).",
    "js": [
      ["process_execute", "\\brequire\\(\\s*['\"](?:node:)?child_process['\"]\\s*\\)\\s*\\.\\s*(?:exec|execSync|spawn|spawnSync|execFile|execFileSync|fork)\\s*\\(\\s*['\"`]([^'\"`]{1,200})", 1],
      ["process_execute", "\\b(?:child_process|childProcess|cp)\\s*\\.\\s*(?:exec|execSync|spawn|spawnSync|execFile|execFileSync|fork)\\s*\\(\\s*['\"`]([^'\"`]{1,200})", 1],
      ["process_execute", "(?<![\\w.$])(?:execSync|spawnSync|execFileSync|execFile|spawn|exec)\\s*\\(\\s*['\"`]([^'\"`]{1,200})", 1],
      ["process_execute", "\\b(?:child_process|childProcess|cp)\\s*\\.\\s*(?:exec|execSync|spawn|spawnSync|execFile|execFileSync|fork)\\s*\\(", null],
      ["process_execute", "(?<![\\w.$])(?:execSync|spawnSync|execFileSync|execFile|spawn|fork)\\s*\\(", null],
      ["network_connect", "\\b(?:https?|http2)\\s*\\.\\s*(?:get|request)\\s*\\(\\s*['\"`]([^'\"`]{1,300})", 1],
      ["network_connect", "\\b(?:fetch|axios(?:\\s*\\.\\s*(?:get|post|put|request))?)\\s*\\(\\s*['\"`](https?://[^'\"`]{1,300})", 1],
      ["network_connect", "\\bnew\\s+WebSocket\\s*\\(\\s*['\"`]([^'\"`]{1,300})", 1],
      ["network_connect", "\\b(?:https?|http2)\\s*\\.\\s*(?:get|request)\\s*\\(|\\bnet\\s*\\.\\s*(?:connect|createConnection)\\s*\\(|\\bdgram\\s*\\.\\s*createSocket\\s*\\(", null],
      ["file_read", "\\b(?:readFileSync|readFile|createReadStream)\\s*\\(\\s*path\\s*\\.\\s*(?:join|resolve)\\s*\\(\\s*(?:os\\s*\\.\\s*)?homedir\\s*\\(\\s*\\)\\s*((?:,\\s*['\"`][^'\"`]+['\"`]\\s*)+)\\)", "home"],
      ["file_read", "\\b(?:readFileSync|readFile|createReadStream)\\s*\\(\\s*['\"`]([^'\"`]{1,300})", 1],
      ["file_read", "\\bfs(?:\\.promises)?\\s*\\.\\s*(?:readFileSync|readFile|createReadStream|readdirSync)\\s*\\(", null],
      ["file_write", "\\b(?:writeFileSync|writeFile|appendFileSync|appendFile|createWriteStream)\\s*\\(\\s*['\"`]([^'\"`]{1,300})", 1],
      ["file_write", "\\bfs(?:\\.promises)?\\s*\\.\\s*(?:writeFileSync|writeFile|appendFileSync|appendFile|createWriteStream|chmodSync)\\s*\\(", null],
      ["file_delete", "\\bfs(?:\\.promises)?\\s*\\.\\s*(?:unlinkSync|unlink|rmSync|rm|rmdirSync)\\s*\\(\\s*['\"`]([^'\"`]{1,300})", 1],
      ["environment_read", "\\bprocess\\.env\\.([A-Za-z_][A-Za-z0-9_]*)", 1],
      ["environment_read", "\\bprocess\\.env\\[\\s*['\"]([A-Za-z_][A-Za-z0-9_]*)['\"]\\s*\\]", 1],
      ["environment_read", "(?:JSON\\.stringify|Object\\.(?:keys|entries|values|assign))\\s*\\(\\s*(?:\\{\\s*\\}\\s*,\\s*)?process\\.env\\s*[,)]", null],
      ["dynamic_code", "(?<![\\w.$])eval\\s*\\(|\\bnew\\s+Function\\s*\\(|\\bvm\\s*\\.\\s*run(?:InNewContext|InThisContext|InContext)\\s*\\(", null]
    ],
    "shell": [
      ["network_connect", "\\b(?:curl|wget)\\b[^|;&\\n]{0,1000}?(https?://[^\\s'\"|;&)]+)", 1],
      ["network_connect", "/dev/(?:tcp|udp)/([^\\s/]+)", 1],
      ["network_connect", "\\b(?:nc|ncat|netcat|socat)\\s+[^|;&\\n]{0,1000}?\\b(\\d{1,3}(?:\\.\\d{1,3}){3}|[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,})\\b", 1],
      ["shell_execute", "\\|\\s*(?:sudo\\s+)?(?:ba|z|da|k)?sh\\b|\\beval\\s|\\b(?:ba|z)?sh\\s+-[ic]\\b", null],
      ["process_execute", "(?:^|[;&|(]\\s*|\\b(?:then|do|sudo|nohup|exec|time)\\s+)((?:\\./|/tmp/|/var/tmp/|/dev/shm/)[\\w./-]+)(?=\\s|$|;|&|\\))", 1],
      ["process_execute", "\\b(?:node|python3?|perl|ruby)\\s+([\\w./-]+\\.(?:c?js|mjs|py|pl|rb))\\b", 1],
      ["file_read", "\\b(?:cat|base64|xxd|head|tail|tar|zip|scp|cp|curl|less|grep)\\b[^|;&\\n]{0,1000}?((?:~|\\$HOME|\\$\\{HOME\\})/[\\w./-]+)", 1],
      ["file_read", "<\\s*((?:~|\\$HOME|\\$\\{HOME\\})/[\\w./-]+)", 1],
      ["file_write", "(?<![<>&0-9])>>?\\s*((?:(?:~|\\$HOME|\\$\\{HOME\\})|/(?!dev/))[\\w./~-]+)", 1],
      ["file_write", "\\btee\\s+(?:-a\\s+)?((?:(?:~|\\$HOME|\\$\\{HOME\\})|/)[\\w./-]+)", 1],
      ["file_delete", "\\brm\\s+(?:-[a-zA-Z]+\\s+)*((?:(?:~|\\$HOME|\\$\\{HOME\\})|/)[\\w./*-]+)", 1],
      ["environment_read", "\\$\\{?([A-Z_][A-Z0-9_]{2,})\\}?", 1],
      ["environment_read", "(?:^|[;&|(]\\s*|\\$\\()(?:printenv|env)\\s*(?:$|[|;&>)])", null]
    ]
  },
