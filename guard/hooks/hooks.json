{
  "description": "AegisPilot: checks install and settings-change commands before they run. The 600s timeout is longer than the guard's own deadline (570s) and scan budget (540s), because a hook that times out lets the command through unchecked.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python_check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse_check.py\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse_editwrite_check.py\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
